# Vite proxies HTTP and WebSocket requests to FastAPI during development.
API_PROXY_TARGET=http://127.0.0.1:8000

# On Vercel, set this to the Render API's HTTPS URL, without /api or a trailing slash.
# The frontend derives wss:// connections from this same URL.
# VITE_API_URL=https://your-gather-api.onrender.com
# Add your exact Vercel origin to the backend's CORS_ORIGINS, then redeploy both apps.
# Never put the MongoDB connection string in a VITE_ variable.
