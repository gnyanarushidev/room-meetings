# Save your actual values in .env or .env.local; .env.local overrides .env.
# Process environment variables (such as Render settings) override both files.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=gather_chat
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ROOM_CAPACITY=100
CREATE_LIMIT_PER_MINUTE=10
JOIN_LIMIT_PER_MINUTE=30
MESSAGE_LIMIT_PER_MINUTE=120
